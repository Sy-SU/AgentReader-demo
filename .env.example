# Keep "fake" for offline tests. Use "deepseek" or "openrouter" for live calls.
LLM_PROVIDER=fake

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek thinking mode is explicit because Tool Calling must replay reasoning.
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

OPENROUTER_API_KEY=
# Use a model slug that supports tool calling, for example provider/model-name.
OPENROUTER_MODEL=
# Optional: enable only when the selected OpenRouter model supports reasoning.
# OPENROUTER_THINKING=enabled
# OPENROUTER_REASONING_EFFORT=low

# Optional one-off overrides shared by both providers:
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_THINKING=
# LLM_REASONING_EFFORT=

# Optional: identify requests to Crossref's polite pool.
CROSSREF_MAILTO=

# Optional: leave blank to use data/library.json.
PAPER_LIBRARY_PATH=

# Optional: leave blank to use data/pdfs/.
PAPER_CACHE_DIR=

# Optional: leave blank to use data/indexes/.
PAPER_INDEX_DIR=
